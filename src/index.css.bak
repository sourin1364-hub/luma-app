@tailwind base;
@tailwind components;
@tailwind utilities;

@font-face { font-family: "Vazir"; src: url("./assets/fonts/vazir/Vazir-Thin-FD-WOL.woff2") format("woff2"); font-weight: 100; font-style: normal; font-display: swap; }
@font-face { font-family: "Vazir"; src: url("./assets/fonts/vazir/Vazir-Light-FD-WOL.woff2") format("woff2"); font-weight: 300; font-style: normal; font-display: swap; }
@font-face { font-family: "Vazir"; src: url("./assets/fonts/vazir/Vazir-FD-WOL.woff2") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: "Vazir"; src: url("./assets/fonts/vazir/Vazir-Medium-FD-WOL.woff2") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
@font-face { font-family: "Vazir"; src: url("./assets/fonts/vazir/Vazir-Bold-FD-WOL.woff2") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
@font-face { font-family: "Yekan Bakh"; src: url("./assets/fonts/yekan-bakh/IRANYekanThin.woff2") format("woff2"); font-weight: 100; font-style: normal; font-display: swap; }
@font-face { font-family: "Yekan Bakh"; src: url("./assets/fonts/yekan-bakh/IRANYekanLight.woff2") format("woff2"); font-weight: 300; font-style: normal; font-display: swap; }
@font-face { font-family: "Yekan Bakh"; src: url("./assets/fonts/yekan-bakh/IRANYekanRegular.woff2") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: "Yekan Bakh"; src: url("./assets/fonts/yekan-bakh/IRANYekanMedium.woff2") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
@font-face { font-family: "Yekan Bakh"; src: url("./assets/fonts/yekan-bakh/IRANYekanBold.woff2") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
@font-face { font-family: "Yekan Bakh"; src: url("./assets/fonts/yekan-bakh/IRANYekanExtraBold.woff2") format("woff2"); font-weight: 800; font-style: normal; font-display: swap; }

@font-face { font-family: "DM Sans"; src: url("./assets/fonts/dmsans/DMSans_18pt-Thin.woff2") format("woff2"); font-weight: 100; font-style: normal; font-display: swap; }
@font-face { font-family: "DM Sans"; src: url("./assets/fonts/dmsans/DMSans_18pt-Light.woff2") format("woff2"); font-weight: 300; font-style: normal; font-display: swap; }
@font-face { font-family: "DM Sans"; src: url("./assets/fonts/dmsans/DMSans_18pt-Regular.woff2") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: "DM Sans"; src: url("./assets/fonts/dmsans/DMSans_18pt-Medium.woff2") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
@font-face { font-family: "DM Sans"; src: url("./assets/fonts/dmsans/DMSans_18pt-SemiBold.woff2") format("woff2"); font-weight: 600; font-style: normal; font-display: swap; }
@font-face { font-family: "DM Sans"; src: url("./assets/fonts/dmsans/DMSans_18pt-Bold.woff2") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
@font-face { font-family: "DM Sans Display"; src: url("./assets/fonts/dmsans/DMSans_24pt-Bold.woff2") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }

@layer base {
  :root {
    --background: 200 80% 85%;
    --foreground: 220 30% 15%;
    --card: 0 0% 100%;
    --card-foreground: 220 30% 15%;
    --popover: 0 0% 100%;
    --popover-foreground: 220 30% 15%;
    --primary: 45 80% 55%;
    --primary-foreground: 230 25% 5%;
    --secondary: 200 50% 90%;
    --secondary-foreground: 220 30% 15%;
    --muted: 200 50% 90%;
    --muted-foreground: 220 20% 40%;
    --accent: 200 50% 90%;
    --accent-foreground: 220 30% 15%;
    --destructive: 0 62% 45%;
    --destructive-foreground: 0 0% 100%;
    --border: 200 30% 80%;
    --input: 200 30% 80%;
    --ring: 45 80% 55%;
    --radius: 1rem;
    
    --glow-color: 199 89% 48%;
    --glow-color-rgb: 14, 165, 233;
    
    --font-sans: "Vazir", "IR Sans", system-ui, sans-serif;
    --font-display: "Yekan Bakh", "Vazir", system-ui, sans-serif;
    --font-logo: "Cinzel", serif;
  }

  html[lang="en"] {
    --font-sans: "DM Sans", system-ui, sans-serif;
    --font-display: "DM Sans Display", system-ui, sans-serif;
  }

  html[data-element="water"] {
    --glow-color: 199 89% 48%;
    --glow-color-rgb: 14, 165, 233;
  }
  html[data-element="water"] body {
    background-color: #bae6fd;
    background-image: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.8) 0%, transparent 60%), linear-gradient(180deg, #e0f2fe 0%, #bae6fd 50%, #7dd3fc 100%);
  }
  html.dark[data-element="water"] body {
    background-color: #0b1120;
    background-image: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.1) 0%, transparent 70%), linear-gradient(180deg, #0b1120 0%, #020617 100%);
  }

  html[data-element="fire"] {
    --glow-color: 20 90% 50%;
    --glow-color-rgb: 249, 115, 22;
  }
  html[data-element="fire"] body {
    background-color: #ffedd5;
    background-image: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.8) 0%, transparent 60%), linear-gradient(180deg, #fef3c7 0%, #ffedd5 50%, #fed7aa 100%);
  }
  html.dark[data-element="fire"] body {
    background-color: #1a0a00;
    background-image: radial-gradient(circle at 50% 0%, rgba(249, 115, 22, 0.1) 0%, transparent 70%), linear-gradient(180deg, #1a0a00 0%, #0a0300 100%);
  }

  html[data-element="earth"] {
    --glow-color: 142 70% 45%;
    --glow-color-rgb: 34, 197, 94;
  }
  html[data-element="earth"] body {
    background-color: #dcfce7;
    background-image: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.8) 0%, transparent 60%), linear-gradient(180deg, #f0fdf4 0%, #dcfce7 50%, #bbf7d0 100%);
  }
  html.dark[data-element="earth"] body {
    background-color: #051005;
    background-image: radial-gradient(circle at 50% 0%, rgba(34, 197, 94, 0.1) 0%, transparent 70%), linear-gradient(180deg, #051005 0%, #020502 100%);
  }

  html[data-element="air"] {
    --glow-color: 45 90% 60%;
    --glow-color-rgb: 250, 204, 21;
  }
  html[data-element="air"] body {
    background-color: #fef08a;
    background-image: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.8) 0%, transparent 60%), linear-gradient(180deg, #fefce8 0%, #fef08a 50%, #fde047 100%);
  }
  html.dark[data-element="air"] body {
    background-color: #1a1500;
    background-image: radial-gradient(circle at 50% 0%, rgba(250, 204, 21, 0.1) 0%, transparent 70%), linear-gradient(180deg, #1a1500 0%, #0a0800 100%);
  }

  * { @apply border-border; }
  html { -webkit-text-size-adjust: 100%; text-rendering: optimizeLegibility; }
  body {
    @apply text-foreground font-sans antialiased;
    font-family: var(--font-sans);
    min-height: 100vh;
    background-color: #bae6fd;
    transition: background 1s ease;
  }
  [lang="fa"] body, [dir="rtl"] body { line-height: 1.85; }
}

@layer utilities {
  .glass-card {
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  .glow-text { text-shadow: 0 0 10px rgba(var(--glow-color-rgb), 0.5); }
  
  /* اصلاح شد: سمی‌کالن به جای کاما */
  .btn-gold {
    background: linear-gradient(135deg, #e6c27a 0%, #d4af37 100%);
    color: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
  }
  .btn-gold:hover { 
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.6); 
    transform: translateY(-1px); 
  }
  
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background-color: rgba(15, 23, 42, 0.2); border-radius: 999px; }
}

@keyframes luma-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.glow-card {
  position: relative;
  overflow: hidden;
  padding: 2px;
  background: transparent;
  z-index: 1;
  border-radius: 1.25rem;
  box-shadow: 0 4px 20px rgba(var(--glow-color-rgb), 0.15);
}
.glow-card::before {
  content: '';
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: conic-gradient(
    transparent 0%,
    transparent 65%,
    rgba(var(--glow-color-rgb), 0.1) 75%,
    rgba(var(--glow-color-rgb), 0.8) 90%,
    rgba(255, 255, 255, 1) 95%,
    transparent 100%
  );
  animation: luma-spin 4s linear infinite;
  z-index: 0;
}
.glow-card-inner {
  position: relative;
  background: rgba(255, 255, 255, 0.95) !important;
  backdrop-filter: blur(8px);
  width: 100%; height: 100%;
  border-radius: 1.1rem;
  z-index: 1;
}

.glow-btn {
  position: relative;
  overflow: hidden;
  padding: 2px;
  background: transparent;
  z-index: 1;
  border-radius: 9999px !important;
  box-shadow: 0 4px 20px rgba(var(--glow-color-rgb), 0.3);
}
.glow-btn::before {
  content: '';
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: conic-gradient(
    transparent 0%,
    transparent 55%,
    rgba(var(--glow-color-rgb), 0.2) 70%,
    rgba(var(--glow-color-rgb), 1) 85%,
    rgba(255, 255, 255, 1) 95%,
    transparent 100%
  );
  animation: luma-spin 2.5s linear infinite;
  z-index: 0;
}
.glow-btn-inner {
  position: relative;
  background: linear-gradient(135deg, rgba(var(--glow-color-rgb), 0.8) 0%, rgba(15, 23, 42, 0.95) 100%) !important;
  width: 100%; height: 100%;
  border-radius: 9999px !important;
  z-index: 1;
  display: flex; align-items: center; justify-content: center;
  color: white !important;
  box-shadow: inset 0 0 20px rgba(var(--glow-color-rgb), 0.2);
}

html.dark .glow-card-inner {
  background: rgba(15, 23, 42, 0.85) !important;
  border: 1px solid rgba(var(--glow-color-rgb), 0.2);
}
html.dark .bg-white\/80,
html.dark .bg-white\/60,
html.dark .bg-white\/95 {
  background-color: rgba(30, 41, 59, 0.8) !important;
}
html.dark .bg-blue-50,
html.dark .bg-blue-50\/80 {
  background-color: rgba(var(--glow-color-rgb), 0.1) !important;
}
html.dark .bg-slate-50,
html.dark .bg-slate-100\/50 {
  background-color: rgba(30, 41, 59, 0.5) !important;
}
html.dark .text-slate-800,
html.dark .text-slate-700 { color: #e2e8f0 !important; }
html.dark .text-slate-600 { color: #cbd5e1 !important; }
html.dark .text-slate-500 { color: #94a3b8 !important; }

html.dark .text-blue-900 { color: rgba(var(--glow-color-rgb), 1) !important; }
html.dark .text-blue-800 { color: rgba(var(--glow-color-rgb), 0.9) !important; }
html.dark .text-blue-700 { color: rgba(var(--glow-color-rgb), 0.8) !important; }
html.dark .text-blue-600 { color: rgba(var(--glow-color-rgb), 0.9) !important; }

html.dark .border-blue-100,
html.dark .border-blue-200 {
  border-color: rgba(var(--glow-color-rgb), 0.2) !important;
}
html.dark .border-slate-200 {
  border-color: rgba(255, 255, 255, 0.1) !important;
}

html.dark .luma-advice-card {
  background: linear-gradient(to bottom right, #1e293b, #0f172a) !important;
  border-color: rgba(var(--glow-color-rgb), 0.3) !important;
}
html.dark .luma-advice-text { color: #e2e8f0 !important; }
html.dark .luma-advice-title { color: rgba(var(--glow-color-rgb), 1) !important; }

html.dark .settings-btn {
  border-color: rgba(var(--glow-color-rgb), 0.4) !important;
  color: rgba(var(--glow-color-rgb), 1) !important;
  background-color: rgba(30, 41, 59, 0.6) !important;
}
html.dark .settings-btn:hover { background-color: rgba(var(--glow-color-rgb), 0.2) !important; }
html.dark .settings-danger-btn {
  border-color: rgba(239, 68, 68, 0.4) !important;
  color: #fca5a5 !important;
  background-color: rgba(30, 41, 59, 0.6) !important;
}
html.dark .settings-danger-btn:hover { background-color: rgba(239, 68, 68, 0.2) !important; }

html.dark .profile-stat-card {
  background-color: rgba(30, 41, 59, 0.8) !important;
  border-color: rgba(var(--glow-color-rgb), 0.2) !important;
}
/* =========================================================
   LUMA LUXURY DARK THEME OVERRIDES
   ========================================================= */
:root {
  --glow-color-rgb: 214, 181, 109; /* Gold default */
}

/* Force dark navy background on the entire app */
html, body, #root {
  background-color: #0B0D1A !important;
  color: #F5F2FA !important;
  min-height: 100vh;
}

/* Override bright white backgrounds to dark luxury cards */
.glass-card,
.bg-white,
.bg-white\/80,
.bg-white\/90,
.bg-\[\#17182B\],
.bg-slate-800\/80 {
  background-color: #17182B !important;
  color: #F5F2FA !important;
  border: 1px solid rgba(214, 181, 109, 0.2) !important;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5) !important;
  backdrop-filter: blur(12px);
}

/* Force text colors to be readable on dark backgrounds */
.text-slate-800,
.text-slate-900,
.text-blue-900,
.text-slate-700 {
  color: #F5F2FA !important;
}

.text-slate-500,
.text-slate-600,
.text-slate-400 {
  color: #AAA7BD !important;
}

/* Gold accent for main titles */
h1, h2, h3 {
  color: #D6B56D !important;
}

/* Purple and Gold for buttons */
.bg-blue-600,
.bg-\[\#8B5CF6\] {
  background-color: #8B5CF6 !important;
  color: white !important;
}

.glow-btn-inner {
  background: linear-gradient(135deg, #8B5CF6, #D6B56D) !important;
  color: #0B0D1A !important;
  font-weight: bold;
}

/* Make sure the big background waves don't stay yellow */
.ElementBackground, .OceanWaves {
  opacity: 0.3 !important;
  filter: hue-rotate(240deg); /* Shift yellow to purple/navy */
}

/* Mobile Responsiveness Fix */
html, body, #root {
  max-width: 100vw;
  overflow-x: hidden;
}
