import { db, type User, type BirthData } from "../../db";
import { useAuthStore } from "../../store/useAuthStore";

export const MAX_USERS = 10;
export const GUEST_USERNAME = "guest";
export const MIN_PASSWORD_LENGTH = 8;
export const MIN_USERNAME_LENGTH = 3;

const PBKDF2_ITERATIONS = 100_000;
const PBKDF2_HASH = "SHA-256";
const SALT_LENGTH_BYTES = 16;
const HASH_LENGTH_BITS = 256;

export type AuthErrorCode =
  | "EMPTY_FIELDS"
  | "USERNAME_TOO_SHORT"
  | "PASSWORD_TOO_SHORT"
  | "USER_LIMIT"
  | "USERNAME_TAKEN"
  | "INVALID_CREDENTIALS";

export interface AuthResult {
  success: boolean;
  error?: AuthErrorCode;
  user?: User;
}

function toHex(buffer: ArrayBuffer): string {
  return Array.from(new Uint8Array(buffer))
    .map((b) => b.toString(16).padStart(2, "0"))
    .join("");
}

function generateSaltHex(): string {
  const salt = crypto.getRandomValues(new Uint8Array(SALT_LENGTH_BYTES));
  return toHex(salt.buffer);
}

async function hashPasswordPBKDF2(
  password: string,
  saltHex: string,
  iterations: number
): Promise<string> {
  const encoder = new TextEncoder();
  const keyMaterial = await crypto.subtle.importKey(
    "raw",
    encoder.encode(password),
    { name: "PBKDF2" },
    false,
    ["deriveBits"]
  );
  const saltBytes = new Uint8Array(
    saltHex.match(/.{1,2}/g)!.map((h) => parseInt(h, 16))
  );
  const derived = await crypto.subtle.deriveBits(
    {
      name: "PBKDF2",
      salt: saltBytes,
      iterations,
      hash: PBKDF2_HASH,
    },
    keyMaterial,
    HASH_LENGTH_BITS
  );
  return toHex(derived);
}

async function hashPasswordLegacy(password: string): Promise<string> {
  const encoder = new TextEncoder();
  const data = encoder.encode(password);
  const hashBuffer = await crypto.subtle.digest("SHA-256", data);
  return toHex(hashBuffer);
}

function isLegacyHash(user: User): boolean {
  return !user.passwordSalt;
}

async function verifyPassword(user: User, password: string): Promise<boolean> {
  if (isLegacyHash(user)) {
    const legacyHash = await hashPasswordLegacy(password);
    return user.passwordHash === legacyHash;
  }
  const newHash = await hashPasswordPBKDF2(
    password,
    user.passwordSalt!,
    PBKDF2_ITERATIONS
  );
  return user.passwordHash === newHash;
}

async function upgradeUserHash(user: User, password: string): Promise<User> {
  if (!user.id) return user;
  const newSalt = generateSaltHex();
  const newHash = await hashPasswordPBKDF2(
    password,
    newSalt,
    PBKDF2_ITERATIONS
  );
  await db.users.update(user.id, {
    passwordHash: newHash,
    passwordSalt: newSalt,
    hashVersion: 2,
  });
  const updated = await db.users.get(user.id);
  return updated ?? user;
}

export async function registerUser(
  username: string,
  password: string
): Promise<AuthResult> {
  const trimmed = username.trim();
  if (!trimmed || !password) return { success: false, error: "EMPTY_FIELDS" };
  if (trimmed.length < MIN_USERNAME_LENGTH)
    return { success: false, error: "USERNAME_TOO_SHORT" };
  if (password.length < MIN_PASSWORD_LENGTH)
    return { success: false, error: "PASSWORD_TOO_SHORT" };

  const realUsers = await db.users.filter((u) => !u.isGuest).count();
  if (realUsers >= MAX_USERS) return { success: false, error: "USER_LIMIT" };

  const existing = await db.users.where("username").equals(trimmed).first();
  if (existing) return { success: false, error: "USERNAME_TAKEN" };

  const salt = generateSaltHex();
  const passwordHash = await hashPasswordPBKDF2(
    password,
    salt,
    PBKDF2_ITERATIONS
  );
  const id = await db.users.add({
    username: trimmed,
    passwordHash,
    passwordSalt: salt,
    hashVersion: 2,
    isGuest: false,
    createdAt: Date.now(),
  });
  const user = await db.users.get(id);
  return { success: true, user };
}

export async function loginUser(
  username: string,
  password: string
): Promise<AuthResult> {
  const trimmed = username.trim();
  if (!trimmed || !password) return { success: false, error: "EMPTY_FIELDS" };

  const user = await db.users.where("username").equals(trimmed).first();
  if (!user || user.isGuest)
    return { success: false, error: "INVALID_CREDENTIALS" };

  const valid = await verifyPassword(user, password);
  if (!valid) return { success: false, error: "INVALID_CREDENTIALS" };

  if (isLegacyHash(user)) {
    try {
      const upgraded = await upgradeUserHash(user, password);
      return { success: true, user: upgraded };
    } catch {
      return { success: true, user };
    }
  }

  return { success: true, user };
}

export async function loginAsGuest(): Promise<AuthResult> {
  const existing = await db.users
    .where("username")
    .equals(GUEST_USERNAME)
    .first();
  if (existing) return { success: true, user: existing };

  const id = await db.users.add({
    username: GUEST_USERNAME,
    isGuest: true,
    createdAt: Date.now(),
  });
  const user = await db.users.get(id);
  return { success: true, user };
}

export async function updateUserBirthData(
  userId: number,
  birthData: BirthData
): Promise<void> {
  await db.users.update(userId, { birthData });
  const updatedUser = await db.users.get(userId);
  if (updatedUser) {
    useAuthStore.getState().setCurrentUser(updatedUser);
  }
}